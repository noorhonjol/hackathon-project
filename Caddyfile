{
	# Disable the admin API (not needed for local dev).
	admin off
}

:80 {
	# API + interactive API docs -> FastAPI backend (internal only, not host-exposed).
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /docs* {
		reverse_proxy backend:8000
	}
	handle /redoc* {
		reverse_proxy backend:8000
	}
	handle /openapi.json {
		reverse_proxy backend:8000
	}

	# Everything else -> Vite dev server (frontend UI, internal only, not host-exposed).
	handle {
		reverse_proxy frontend:5173
	}
}

# To enable auto-HTTPS on a real domain, replace `:80` with your domain, e.g.:
#   app.example.com {
#       reverse_proxy /api/* backend:8000
#       reverse_proxy /docs* backend:8000
#       reverse_proxy /openapi.json backend:8000
#       reverse_proxy frontend:5173
#   }