# PostgreSQL (local compose service)
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=hackathon
POSTGRES_DB=hackathon

# CORS (comma-separated allowed origins). With Caddy as the single entry point,
# the browser origin is the Caddy host, so this defaults to http://localhost:8080.
CORS_ORIGINS=http://localhost:8080

# DigitalOcean Spaces (S3-compatible, cloud only)
# Leave blank to disable storage status checks in dev.
S3_ENDPOINT_URL=https://your-space-name.nyc3.digitaloceanspaces.com
S3_REGION=nyc3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=your-space-name