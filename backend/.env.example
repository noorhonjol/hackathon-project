# Used when running the backend OUTSIDE docker compose (local dev).
# Inside compose, DATABASE_URL is built from the POSTGRES_* vars in the root .env.
DATABASE_URL=postgresql://hackathon:hackathon@localhost:5432/hackathon
CORS_ORIGINS=http://localhost:5173

# DigitalOcean Spaces (S3-compatible, cloud only)
S3_ENDPOINT_URL=https://your-space-name.nyc3.digitaloceanspaces.com
S3_REGION=nyc3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=your-space-name